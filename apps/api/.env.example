PORT=4000
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/memories
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/memories?sslmode=disable
SESSION_SECRET=YOUR_SESSION_SECRET
RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-xxxx?key=YOUR
# Photos: "local" (the uploads folder, for development) or "s3" (a cloud bucket, for production)
PHOTO_STORAGE=local
# Needed only when PHOTO_STORAGE=s3 (Cloudflare R2 example)
S3_BUCKET=memories-photos
S3_REGION=auto
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
S3_PUBLIC_URL=https://pub-YOUR_ID.r2.dev
