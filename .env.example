# Copy this file to .env (in the project root) and fill in your own values.
# Used only by docker compose to create the local Postgres database.
# Never commit .env (it's in .gitignore).

POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=memories

# The API's settings are in apps/api/.env (see apps/api/.env.example).
# Production settings (Neon, Cloudinary) live in Render's Environment tab, not in any file.