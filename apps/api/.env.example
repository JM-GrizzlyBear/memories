# Copy this file to apps/api/.env and fill in your own values.
# Never commit apps/api/.env (it's in .gitignore).

PORT=4000

# Local Postgres (docker compose). On Render, use your Neon connection string instead.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/memories?sslmode=disable

# Any long random string (e.g. run: openssl rand -hex 32)
SESSION_SECRET=YOUR_SESSION_SECRET

# Only used by the manual Deploy workflow (GitHub secret), not by the app
RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-xxxx?key=YOUR

# Where photos are saved:
#   local      → the apps/api/uploads folder (development; Render deletes it on every deploy)
#   cloudinary → your Cloudinary account (production)
PHOTO_STORAGE=local

# Needed only when PHOTO_STORAGE=cloudinary.
# Cloudinary dashboard → Settings → API Keys → copy "API environment variable"
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Optional: folder for the photos in your Cloudinary media library (default: memories)
CLOUDINARY_FOLDER=memories
