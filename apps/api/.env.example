# Copy this file to apps/api/.env and fill in your own values.
# Never commit apps/api/.env (it's in .gitignore).

PORT=4000

# Local Postgres (docker compose). On Render, use your Neon connection string instead.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/memories?sslmode=disable

# Any long random string (e.g. run: openssl rand -hex 32)
SESSION_SECRET=YOUR_SESSION_SECRET

# Only used by the manual Deploy workflow (GitHub secret), not by the app
RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-xxxx?key=YOUR

# Where photos are saved:
#   local      → the apps/api/uploads folder (development; Render deletes it on every deploy)
#   cloudinary → your Cloudinary account (production)
PHOTO_STORAGE=local

# Needed only when PHOTO_STORAGE=cloudinary.
# Cloudinary dashboard → Settings → API Keys → copy "API environment variable"
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Optional: folder for the photos in your Cloudinary media library (default: memories)
CLOUDINARY_FOLDER=memories

# Forgot-password emails. Locally they go to Mailpit (docker compose up -d mail)
# and show up at http://localhost:8025. Leave SMTP_HOST empty to turn email off:
# the Forgot password page then says it isn't available (like on Render's free plan).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=Memories <no-reply@memories.local>
# The website's address, used in the links inside emails (no "/" at the end)
APP_URL=http://localhost:5173

# Live site only (Render → Environment), with a real email service such as Brevo:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=2525   (Render's free plan blocks 25, 465 and 587)
#   SMTP_USER=xxxxxx@smtp-brevo.com   (Brevo's SMTP login, not your account email)
#   SMTP_PASS=your-brevo-smtp-key
#   MAIL_FROM=Memories <the-sender-you-verified-on-brevo@example.com>
#   APP_URL=https://your-site.netlify.app
# Mailpit needs no login: leave these two empty locally.
SMTP_USER=
SMTP_PASS=

# How many proxies sit in front of the API, so it sees each visitor's real IP
# address. Locally: 0 (the default). Render alone: 1. Netlify, then Render: 2.
# TRUST_PROXY=0
